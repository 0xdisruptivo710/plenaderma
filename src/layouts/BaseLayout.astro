---
/**
 * BaseLayout - shell raiz de todas as páginas.
 * Define <head>, fontes, meta tags, Schema.org básico (LocalBusiness + MedicalBusiness).
 */
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/primitives.css';
import { CLINIC } from '../lib/clinic';

interface Props {
  title: string;
  description: string;
  /** Path relativo da imagem OG (default: hero da home) */
  ogImage?: string;
  /** Canonical absoluto (default: derivado de Astro.site + pathname) */
  canonical?: string;
  /** Schema.org adicional para procedimentos */
  procedureSchema?: object;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  canonical,
  procedureSchema,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = canonical ?? `${site}${Astro.url.pathname}`;
const ogUrl = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;

// Schema.org LocalBusiness + MedicalBusiness (SEO local Asa Norte é prioridade)
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'LocalBusiness'],
  name: CLINIC.name,
  description:
    'Clínica de estética facial e corporal na Asa Norte, Brasília. Protocolos personalizados, Ultraformer, harmonização facial, lasers e depilação a laser.',
  url: site,
  telephone: '+55-61-99588-8306',
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: CLINIC.address.street,
    addressLocality: CLINIC.address.city,
    addressRegion: CLINIC.address.state,
    postalCode: CLINIC.address.postalCode,
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -15.7375,
    longitude: -47.8865,
  },
  sameAs: [CLINIC.social.instagram],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#2A1B14" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts v1.0: Cormorant Garamond (serif display) + DM Sans (corpo) + DM Mono (labels). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=DM+Mono:wght@300;400&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    {procedureSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(procedureSchema)} />}
  </head>

  <body>
    <a href="#main" class="skip-link">Pular para o conteúdo</a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />
    <slot name="floats" />

    <script>
      // Reveal-on-scroll observer
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );

      const init = () => {
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        top: -100px;
        left: var(--space-4);
        z-index: 999;
        padding: var(--space-3) var(--space-5);
        background-color: var(--brand-dark);
        color: var(--brand-light);
        font-family: var(--font-mono);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: var(--track-mono);
        border-radius: var(--radius-sm);
        transition: top var(--dur-fast) var(--ease-out);
      }
      .skip-link:focus-visible { top: var(--space-4); }
    </style>
  </body>
</html>
