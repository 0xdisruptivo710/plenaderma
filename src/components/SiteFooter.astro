---
/**
 * Site Footer v1.0 - Plena Derma. Fundo marfim, wordmark gigante editorial.
 * TODO go-live: incluir responsável técnico e registro (obrigatório em
 * publicidade de saúde) assim que confirmados com a clínica.
 */
import { CLINIC, whatsappUrl, WA_MESSAGES } from '../lib/clinic';
---

<footer class="site-footer">
  <div class="container container--wide site-footer__inner">
    <div class="site-footer__cols">
      <section>
        <h4 class="site-footer__heading">Unidade</h4>
        <ul>
          <li>{CLINIC.address.street}</li>
          <li>{CLINIC.address.neighborhood}, {CLINIC.address.city} · {CLINIC.address.state}</li>
          <li>{CLINIC.address.postalCode}</li>
          <li>
            <a href={CLINIC.mapLink} target="_blank" rel="noopener noreferrer">Como chegar</a>
          </li>
        </ul>
      </section>

      <section>
        <h4 class="site-footer__heading">Cuidados</h4>
        <ul>
          <li><a href="/harmonizacao-facial/">Harmonização Facial</a></li>
          <li><a href="/ultraformer/">Ultraformer</a></li>
          <li><a href="/lasers-e-pele/">Lasers e Pele</a></li>
          <li><a href="/corporal/">Estética Corporal</a></li>
          <li><a href="/depilacao-a-laser/">Depilação a Laser</a></li>
        </ul>
      </section>

      <section>
        <h4 class="site-footer__heading">Contato</h4>
        <ul>
          <li>
            <a href={whatsappUrl(WA_MESSAGES.general)} target="_blank" rel="noopener noreferrer">
              WhatsApp · {CLINIC.phone}
            </a>
          </li>
          <li>
            <a href={CLINIC.social.instagram} target="_blank" rel="noopener noreferrer">
              Instagram · @plenaderma
            </a>
          </li>
        </ul>
      </section>

      <section>
        <h4 class="site-footer__heading">A Plena Derma</h4>
        <ul>
          <li><a href="/sobre/">Sobre a clínica</a></li>
          <li><a href="/contato/">Contato e como chegar</a></li>
          <li>{CLINIC.hours.fullLine}</li>
          <li>
            <a href={whatsappUrl(WA_MESSAGES.general)} target="_blank" rel="noopener noreferrer">
              Agende sua avaliação
            </a>
          </li>
        </ul>
      </section>
    </div>

    <div class="site-footer__wordmark" aria-hidden="true">
      <span class="site-footer__wordmark-italic">Plena</span>
      <span>Derma</span>
    </div>

    <div class="site-footer__legal">
      <span class="site-footer__brand">
        <span class="site-footer__brand-plena">Plena</span>
        <span class="site-footer__brand-derma">Derma</span>
        <span class="site-footer__brand-sig">· {CLINIC.signature}</span>
      </span>
      <div class="site-footer__legal-links">
        <a href={CLINIC.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={CLINIC.mapLink} target="_blank" rel="noopener noreferrer">Endereço</a>
      </div>
      <span class="site-footer__copy">© {new Date().getFullYear()} {CLINIC.name}. Todos os direitos reservados.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--brand-cream);
    color: var(--brand-dark);
    padding-block: var(--space-10) var(--space-5);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-7);
  }
  @media (min-width: 768px) {
    .site-footer__cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--brand-accent);
    margin-block-end: var(--space-4);
    font-weight: var(--weight-regular);
  }

  .site-footer__cols ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .site-footer__cols li,
  .site-footer__cols a {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--weight-light);
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-footer__cols a:hover { color: var(--brand-accent); }

  .site-footer__wordmark {
    text-align: center;
    overflow: hidden;
    border-block-end: 1px solid var(--border-faint);
    padding-block-end: var(--space-7);
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: baseline;
    gap: 2vw;
    line-height: 0.85;
  }
  .site-footer__wordmark span {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: clamp(3rem, 12vw, 10rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: var(--brand-dark);
    white-space: nowrap;
  }
  .site-footer__wordmark-italic {
    font-style: italic;
    color: var(--brand-primary) !important;
  }

  .site-footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
    text-align: center;
    color: var(--text-soft);
    font-size: 11px;
    font-family: var(--font-sans);
  }
  @media (min-width: 768px) {
    .site-footer__legal {
      flex-direction: row;
      justify-content: space-between;
      text-align: start;
    }
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .site-footer__brand-plena {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    color: var(--brand-dark);
  }
  .site-footer__brand-derma {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--brand-accent);
  }
  .site-footer__brand-sig {
    font-size: 11px;
    color: var(--text-soft);
  }

  .site-footer__legal-links {
    display: flex;
    gap: var(--space-5);
  }
  .site-footer__legal-links a {
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-footer__legal-links a:hover { color: var(--brand-accent); }
</style>
