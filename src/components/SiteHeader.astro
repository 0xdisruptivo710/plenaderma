---
/**
 * Site Header v1.0 - Plena Derma
 * Wordmark tipográfico ("Plena" serif itálico + "DERMA" sans espaçado).
 * Transparente sobre hero, vira brand-light + blur após 60px de scroll.
 */
import { whatsappUrl, WA_MESSAGES } from '../lib/clinic';
import { TREATMENTS } from '../lib/treatments';

interface Props {
  /** 'dark' sobre hero escuro (home); 'light' sobre páginas de fundo claro */
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;

const navItems = [
  ...TREATMENTS.map((t) => ({ label: t.navLabel, href: `/${t.slug}/` })),
  { label: 'Sobre',   href: '/sobre/' },
  { label: 'Contato', href: '/contato/' },
];
---

<header class="site-header" data-state="top" data-tone={tone}>
  <div class="site-header__inner container container--wide">
    <a href="/" class="site-header__brand" aria-label="Plena Derma - início">
      <span class="site-header__wm-plena">Plena</span>
      <span class="site-header__wm-derma">Derma</span>
    </a>

    <nav class="site-header__nav" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a href={item.href} class="site-header__link">
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href={whatsappUrl(WA_MESSAGES.general)}
      target="_blank"
      rel="noopener noreferrer"
      class="site-header__cta"
    >
      Agende sua avaliação
    </a>

    <button
      class="site-header__menu-toggle"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" class="site-header__mobile" hidden>
    <nav aria-label="Navegação principal mobile">
      <a href="/" class="site-header__mobile-link">Início</a>
      {navItems.map((item) => (
        <a href={item.href} class="site-header__mobile-link">{item.label}</a>
      ))}
      <a
        href={whatsappUrl(WA_MESSAGES.general)}
        target="_blank"
        rel="noopener noreferrer"
        class="site-header__mobile-link site-header__mobile-link--accent"
      >
        Agendar
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-nav);
    color: #fff;
    transition: background-color var(--dur-base) var(--ease-out),
                color var(--dur-base) var(--ease-out),
                backdrop-filter var(--dur-base) var(--ease-out),
                padding var(--dur-base) var(--ease-out);
  }

  .site-header[data-state="top"] {
    background-color: transparent;
  }
  .site-header[data-tone="light"][data-state="top"] {
    color: var(--brand-dark);
  }
  .site-header[data-tone="light"][data-state="top"] .site-header__cta {
    border-color: var(--brand-dark);
  }
  .site-header[data-tone="light"][data-state="top"] .site-header__cta:hover {
    background-color: var(--brand-dark);
    color: var(--brand-light);
  }

  .site-header[data-state="scrolled"] {
    background-color: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: var(--brand-dark);
    border-bottom: 1px solid var(--border-faint);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-5);
    position: relative;
    z-index: calc(var(--z-nav) + 1); /* toggle acima do overlay do menu mobile (que usa --z-nav) */
  }

  .site-header[data-state="scrolled"] .site-header__inner {
    padding-block: var(--space-4);
  }

  /* Brand wordmark */
  .site-header__brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    line-height: 1;
    color: currentColor;
  }
  .site-header__wm-plena {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--weight-medium);
    font-size: 1.75rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .site-header__wm-derma {
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    line-height: 1;
    color: var(--brand-gold);
  }

  /* Nav (desktop) */
  .site-header__nav {
    display: none;
    gap: clamp(1.25rem, 2vw, 2.5rem);
  }
  @media (min-width: 1100px) {
    .site-header__nav { display: flex; }
  }

  .site-header__link {
    position: relative;
    color: currentColor;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-header__link:hover { color: var(--brand-gold); }

  /* CTA */
  .site-header__cta {
    display: none;
    color: currentColor;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    padding: 0.5rem 1.5rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    transition: background-color var(--dur-base) var(--ease-out),
                color var(--dur-base) var(--ease-out);
  }
  @media (min-width: 768px) {
    .site-header__cta { display: inline-flex; align-items: center; }
  }
  .site-header[data-state="top"] .site-header__cta {
    border-color: rgba(255, 255, 255, 0.4);
  }
  .site-header[data-state="top"] .site-header__cta:hover {
    background-color: #fff;
    color: var(--brand-dark);
  }
  .site-header[data-state="scrolled"] .site-header__cta {
    border-color: var(--brand-dark);
  }
  .site-header[data-state="scrolled"] .site-header__cta:hover {
    background-color: var(--brand-dark);
    color: var(--brand-light);
  }

  /* Menu toggle (mobile) */
  .site-header__menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-3);
    margin-inline-end: calc(var(--space-3) * -1);
  }
  @media (min-width: 1100px) {
    .site-header__menu-toggle { display: none; }
  }
  .site-header__menu-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    background-color: currentColor;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .site-header__menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(3px) rotate(45deg);
  }
  .site-header__menu-toggle[aria-expanded="true"] span:nth-child(2) {
    transform: translateY(-3px) rotate(-45deg);
  }
  /* Com o menu aberto (fundo chocolate), o X precisa ser claro em qualquer tone */
  .site-header__menu-toggle[aria-expanded="true"] {
    color: var(--brand-light);
  }

  /* Mobile fullscreen menu */
  .site-header__mobile {
    position: fixed;
    inset: 0;
    background-color: var(--brand-dark);
    color: var(--brand-light);
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: circle(0% at calc(100% - 40px) 40px);
    transition: clip-path 800ms var(--ease-out);
    pointer-events: none;
  }
  .site-header__mobile[aria-hidden="false"] {
    clip-path: circle(150% at calc(100% - 40px) 40px);
    pointer-events: auto;
  }
  .site-header__mobile nav {
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.6vh, 1.25rem);
    text-align: center;
    max-height: 100dvh;
    overflow-y: auto;
    padding-block: clamp(4.5rem, 10vh, 6rem) var(--space-7);
    width: 100%;
  }
  .site-header__mobile-link {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 4.2vh, 2.25rem);
    font-weight: var(--weight-regular);
    color: var(--brand-light);
    letter-spacing: var(--track-tight);
    line-height: 1.25;
  }
  .site-header__mobile-link--accent { color: var(--brand-gold); font-style: italic; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const onScroll = () => {
      header.dataset.state = window.scrollY > 60 ? 'scrolled' : 'top';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>('.site-header__menu-toggle');
  const mobile = document.querySelector<HTMLElement>('.site-header__mobile');
  if (toggle && mobile) {
    mobile.hidden = false;
    mobile.setAttribute('aria-hidden', 'true');

    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      mobile.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        mobile.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    });

    mobile.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  }
</script>
