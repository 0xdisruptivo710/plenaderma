---
/**
 * UltraformerFeature v1.0 - Plena Derma. Tecnologia de assinatura da casa:
 * o Ultraformer é próprio (argumento de autoridade), não alugado.
 */
import { whatsappUrl, WA_MESSAGES } from '../../lib/clinic';

const wa = whatsappUrl(WA_MESSAGES.ultraformer);
---

<section id="tecnologia" class="ultra-feature">
  <div class="container container--wide ultra-feature__inner">
    <div class="ultra-feature__media reveal">
      <figure class="ultra-feature__figure">
        <video
          src="/video/ultraformer.mp4"
          poster="/video/ultraformer-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      </figure>
      <div class="ultra-feature__caption" aria-hidden="true">
        <p>A arte<br />da firmeza</p>
      </div>
    </div>

    <div class="ultra-feature__body reveal" style="--reveal-delay: 2">
      <span class="ultra-feature__outline outline-num outline-num--gold" aria-hidden="true">03</span>
      <p class="eyebrow eyebrow--accent">03 - Tecnologia de Assinatura</p>
      <h2 class="ultra-feature__title">
        Ultraformer,<br />
        <em>tecnologia própria.</em>
      </h2>
      <p class="ultra-feature__p">
        O Ultraformer mora aqui. O equipamento é da Plena Derma, e a agenda
        dele também: ultrassom micro e macrofocado para firmeza e contorno
        de rosto, papada e corpo, sempre conduzido por avaliação profissional.
      </p>
      <p class="ultra-feature__p">
        E como todo bom trabalho de colágeno, ele respeita o seu tempo:
        a evolução acontece de forma gradual ao longo de cerca de três meses,
        com naturalidade que acompanha a sua expressão.
      </p>
      <div class="ultra-feature__actions">
        <a href="/ultraformer/" class="link-edit ultra-feature__cta">
          Conhecer o Ultraformer <span aria-hidden="true">→</span>
        </a>
        <a href={wa} target="_blank" rel="noopener noreferrer" class="link-edit ultra-feature__cta">
          Agendar avaliação <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ultra-feature {
    background-color: var(--brand-cream);
    color: var(--brand-dark);
    padding-block: clamp(6rem, 12vh, 10rem);
    position: relative;
    overflow: hidden;
  }

  .ultra-feature__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9);
    align-items: center;
  }
  @media (min-width: 900px) {
    .ultra-feature__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
  }

  /* Media */
  .ultra-feature__media {
    position: relative;
  }
  .ultra-feature__figure {
    width: min(100%, 30rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  .ultra-feature__figure video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(0.95) brightness(0.98);
    transition: transform 1200ms var(--ease-out);
    display: block;
  }
  .ultra-feature__media:hover .ultra-feature__figure video {
    transform: scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .ultra-feature__figure video { display: none; }
    .ultra-feature__figure {
      background-image: url('/video/ultraformer-poster.jpg');
      background-size: cover;
      background-position: center;
    }
  }

  .ultra-feature__caption {
    position: absolute;
    inset-block-end: -1.5rem;
    inset-inline-end: 0;
    background-color: var(--brand-light);
    border: 1px solid var(--border-faint);
    padding: var(--space-6) var(--space-7);
  }
  @media (min-width: 900px) {
    .ultra-feature__caption { inset-inline-end: var(--space-6); }
  }
  .ultra-feature__caption p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--brand-dark);
    text-align: center;
  }

  /* Body */
  .ultra-feature__body {
    position: relative;
  }

  .ultra-feature__outline {
    position: absolute;
    inset-block-start: -4rem;
    inset-inline-end: 0;
    pointer-events: none;
    display: none;
  }
  @media (min-width: 900px) {
    .ultra-feature__outline { display: block; }
  }

  .ultra-feature__title {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--track-h2);
    color: var(--brand-dark);
    margin-block: var(--space-5) var(--space-6);
  }
  .ultra-feature__title em {
    font-style: italic;
    color: var(--brand-accent);
  }

  .ultra-feature__p {
    font-family: var(--font-sans);
    font-weight: var(--weight-light);
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-body);
    max-width: 34rem;
    margin-block-end: var(--space-5);
  }

  .ultra-feature__actions {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-block-start: var(--space-3);
  }
  .ultra-feature__cta {
    color: var(--brand-accent);
  }
</style>
