---
/**
 * Protocols v1.0 - Plena Derma. Dark luxury section com 5 frentes de cuidado
 * em grid staggered. Cada card converte direto no WhatsApp com mensagem própria.
 */
import { whatsappUrl, WA_MESSAGES } from '../../lib/clinic';
---

<section id="protocolos" class="protocols-v3">
  <div class="protocols-v3__bg-gradient" aria-hidden="true"></div>

  <div class="container container--wide protocols-v3__inner">
    <header class="protocols-v3__head">
      <div>
        <p class="protocols-v3__eyebrow">03 - Nossos Cuidados</p>
        <h2 class="protocols-v3__title">Rosto e corpo,<br />sob medida.</h2>
      </div>
      <p class="protocols-v3__lead">
        Cinco frentes de cuidado, um mesmo método: avaliação primeiro,
        protocolo personalizado depois.
      </p>
    </header>

    <div class="protocols-v3__grid">
      <article class="protocols-v3__card protocols-v3__card--01 hover-trigger reveal">
        <a href={whatsappUrl(WA_MESSAGES.injetaveis)} target="_blank" rel="noopener noreferrer" class="protocols-v3__card-link">
          <figure class="protocols-v3__card-media protocols-v3__card-media--3x4">
            <img
              src="/modelos/modelo-injetaveis.jpg"
              alt="Aplicação delicada de injetável facial em ambiente acolhedor"
              loading="lazy"
            />
            <span class="protocols-v3__card-tag">Injetáveis</span>
          </figure>
          <h3 class="protocols-v3__card-title">Harmonização Facial</h3>
          <p class="protocols-v3__card-eyebrow">Toxina · Preenchimento · Bioestimuladores</p>
          <div class="hover-target">
            <p class="protocols-v3__card-body">
              Toxina botulínica, preenchimento com ácido hialurônico,
              bioestimuladores de colágeno e fios de PDO. Técnica que
              preserva a sua expressão e o seu jeito de ser.
            </p>
            <span class="protocols-v3__card-cta">Agendar avaliação →</span>
          </div>
        </a>
      </article>

      <article class="protocols-v3__card protocols-v3__card--02 hover-trigger reveal">
        <a href={whatsappUrl(WA_MESSAGES.ultraformer)} target="_blank" rel="noopener noreferrer" class="protocols-v3__card-link">
          <figure class="protocols-v3__card-media protocols-v3__card-media--4x5">
            <img
              src="/modelos/modelo-ultraformer.jpg"
              alt="Procedimento de tecnologia estética em pele iluminada"
              loading="lazy"
            />
            <span class="protocols-v3__card-tag">Tecnologia</span>
          </figure>
          <h3 class="protocols-v3__card-title">Ultraformer</h3>
          <p class="protocols-v3__card-eyebrow">Firmeza &amp; Contorno</p>
          <div class="hover-target">
            <p class="protocols-v3__card-body">
              Ultrassom micro e macrofocado para rosto, papada e corpo.
              Tecnologia própria da clínica, com protocolos de full face
              a contorno corporal.
            </p>
            <span class="protocols-v3__card-cta">Agendar avaliação →</span>
          </div>
        </a>
      </article>

      <article class="protocols-v3__card protocols-v3__card--03 hover-trigger reveal">
        <a href={whatsappUrl(WA_MESSAGES.lasers)} target="_blank" rel="noopener noreferrer" class="protocols-v3__card-link">
          <figure class="protocols-v3__card-media protocols-v3__card-media--4x5">
            <img
              src="/modelos/modelo-lasers.jpg"
              alt="Tratamento de pele com máscara em ambiente de clínica"
              loading="lazy"
            />
            <span class="protocols-v3__card-tag">Pele</span>
          </figure>
          <h3 class="protocols-v3__card-title">Lasers &amp; Pele</h3>
          <p class="protocols-v3__card-eyebrow">CO2 · Lavieen · Peelings</p>
          <div class="hover-target">
            <p class="protocols-v3__card-body">
              Laser de CO2 fracionado, Lavieen, microagulhamento, peelings
              e limpeza de pele. Textura, viço e uniformidade, da renovação
              intensa ao cuidado de rotina.
            </p>
            <span class="protocols-v3__card-cta">Agendar avaliação →</span>
          </div>
        </a>
      </article>

      <article class="protocols-v3__card protocols-v3__card--04 hover-trigger reveal">
        <a href={whatsappUrl(WA_MESSAGES.corporal)} target="_blank" rel="noopener noreferrer" class="protocols-v3__card-link">
          <figure class="protocols-v3__card-media protocols-v3__card-media--16x9">
            <img
              src="/modelos/modelo-corporal.jpg"
              alt="Pele dos ombros e colo em luz quente - cuidado corporal"
              loading="lazy"
            />
            <span class="protocols-v3__card-tag">Corpo</span>
          </figure>
          <h3 class="protocols-v3__card-title">Estética Corporal</h3>
          <p class="protocols-v3__card-eyebrow">Contorno &amp; Firmeza</p>
          <div class="hover-target">
            <p class="protocols-v3__card-body">
              Harmonização glútea, lipo enzimática e protocolos para
              celulite, estrias e flacidez. Seu corpo também merece esse
              nível de cuidado.
            </p>
            <span class="protocols-v3__card-cta">Agendar avaliação →</span>
          </div>
        </a>
      </article>

      <article class="protocols-v3__card protocols-v3__card--05 hover-trigger reveal">
        <a href={whatsappUrl(WA_MESSAGES.depilacao)} target="_blank" rel="noopener noreferrer" class="protocols-v3__card-link">
          <figure class="protocols-v3__card-media protocols-v3__card-media--3x4">
            <img
              src="/modelos/modelo-depilacao.jpg"
              alt="Sessão de depilação a laser com óculos de proteção"
              loading="lazy"
            />
            <span class="protocols-v3__card-tag protocols-v3__card-tag--new">Novo</span>
          </figure>
          <h3 class="protocols-v3__card-title">Depilação a Laser</h3>
          <p class="protocols-v3__card-eyebrow">Soprano Ice Platinum</p>
          <div class="hover-target">
            <p class="protocols-v3__card-body">
              Depilação a laser com Soprano Ice Platinum: sessões
              confortáveis, tecnologia indicada para diferentes fototipos
              e avaliação profissional antes de começar.
            </p>
            <span class="protocols-v3__card-cta">Agendar avaliação →</span>
          </div>
        </a>
      </article>
    </div>

    <div class="protocols-v3__cta">
      <a href={whatsappUrl(WA_MESSAGES.general)} target="_blank" rel="noopener noreferrer" class="protocols-v3__cta-link">
        <span>Conversar com a equipe</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .protocols-v3 {
    position: relative;
    background-color: var(--brand-dark);
    color: var(--brand-light);
    padding-block: clamp(6rem, 14vh, 12rem);
    overflow: hidden;
  }

  .protocols-v3__bg-gradient {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: 50%;
    height: 100%;
    background-image: linear-gradient(to left, var(--brand-dark-2), transparent);
    opacity: 0.5;
    pointer-events: none;
  }

  .protocols-v3__inner { position: relative; z-index: 1; }

  /* Head */
  .protocols-v3__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    justify-content: space-between;
    border-block-end: 1px solid rgba(197, 168, 128, 0.3);
    padding-block-end: var(--space-7);
    margin-block-end: var(--space-10);
  }
  @media (min-width: 768px) {
    .protocols-v3__head { flex-direction: row; align-items: flex-end; }
  }

  .protocols-v3__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--brand-gold);
    margin-block-end: var(--space-3);
  }

  .protocols-v3__title {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: var(--track-tight);
    line-height: 1;
    color: var(--brand-light);
  }

  .protocols-v3__lead {
    font-family: var(--font-sans);
    font-weight: var(--weight-light);
    font-size: var(--text-sm);
    color: rgba(250, 248, 245, 0.7);
    max-width: 22rem;
    line-height: var(--leading-body);
  }
  @media (min-width: 768px) {
    .protocols-v3__lead { text-align: end; margin-block-end: 0.5rem; }
  }

  /* Grid staggered - 5 cards */
  .protocols-v3__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9);
  }
  @media (min-width: 900px) {
    .protocols-v3__grid {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--space-7) var(--space-6);
    }
    .protocols-v3__card--01 { grid-column: 1 / span 5; }
    .protocols-v3__card--02 { grid-column: 8 / span 4; margin-block-start: 10rem; }
    .protocols-v3__card--03 { grid-column: 2 / span 4; margin-block-start: -4rem; }
    .protocols-v3__card--04 { grid-column: 7 / span 5; margin-block-start: 6rem; }
    .protocols-v3__card--05 { grid-column: 4 / span 5; margin-block-start: 4rem; }
  }

  .protocols-v3__card-link {
    display: block;
    color: inherit;
  }

  /* Media */
  .protocols-v3__card-media {
    position: relative;
    overflow: hidden;
    margin-block-end: var(--space-5);
  }
  .protocols-v3__card-media--3x4  { aspect-ratio: 3 / 4; }
  .protocols-v3__card-media--4x5  { aspect-ratio: 4 / 5; }
  .protocols-v3__card-media--16x9 { aspect-ratio: 16 / 9; }

  .protocols-v3__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(0.9) brightness(0.9);
    transition: transform 1200ms var(--ease-out), filter var(--dur-slow) var(--ease-out);
  }
  .protocols-v3__card:hover .protocols-v3__card-media img {
    transform: scale(1.05);
    filter: contrast(1.1) saturate(1) brightness(1);
  }

  .protocols-v3__card-tag {
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-start: var(--space-4);
    background-color: rgba(42, 27, 20, 0.9);
    backdrop-filter: blur(8px);
    color: #fff;
    padding: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    border-radius: var(--radius-xs);
  }
  .protocols-v3__card-tag--new {
    background-color: var(--brand-gold);
    color: var(--brand-dark);
  }

  /* Card text */
  .protocols-v3__card-title {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--brand-light);
    margin-block-end: var(--space-2);
    transition: color var(--dur-base) var(--ease-out);
  }
  .protocols-v3__card:hover .protocols-v3__card-title { color: var(--brand-gold); }

  .protocols-v3__card-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--brand-gold);
  }

  .protocols-v3__card-body {
    font-family: var(--font-sans);
    font-weight: var(--weight-light);
    font-size: var(--text-sm);
    color: rgba(250, 248, 245, 0.7);
    line-height: var(--leading-body);
    margin-block-end: var(--space-4);
  }

  .protocols-v3__card-cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--brand-light);
    border-block-end: 1px solid rgba(250, 248, 245, 0.3);
    padding-block-end: 4px;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .protocols-v3__card:hover .protocols-v3__card-cta {
    color: var(--brand-gold);
    border-color: var(--brand-gold);
  }

  /* CTA Final */
  .protocols-v3__cta {
    margin-block-start: var(--space-10);
    text-align: center;
  }
  .protocols-v3__cta-link {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    color: var(--brand-gold);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    border-block-end: 1px solid var(--brand-gold);
    padding-block-end: var(--space-3);
    transition: color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .protocols-v3__cta-link:hover {
    color: #fff;
    border-color: #fff;
  }
</style>
