---
/**
 * ClinicGallery v2.0 - galeria da clínica só com fotos reais, sem slots de
 * preenchimento. A fachada aparece por completo (tile com aspect igual ao
 * corte, sem cover-crop no letreiro).
 */
import { CLINIC } from '../../lib/clinic';
---

<section id="clinica" class="cgal">
  <div class="container container--wide">
    <header class="cgal__head reveal">
      <div>
        <p class="cgal__eyebrow">04 - A Clínica</p>
        <h2 class="cgal__title">A casa da<br /><em>Plena Derma.</em></h2>
      </div>
      <div class="cgal__head-right">
        <p class="cgal__lead">
          Mais de 3 anos de história na Asa Norte: a mesma equipe, o mesmo
          padrão de excelência e 4 salas de atendimento num espaço pensado
          para acolher você da recepção ao pós-protocolo.
        </p>
        <a href="/sobre/" class="link-edit cgal__link">Conhecer a clínica e a equipe →</a>
      </div>
    </header>

    <div class="cgal__grid">
      <figure class="cgal__tile cgal__tile--fachada reveal">
        <img src="/clinica/fachada-completa.jpg" alt="Fachada completa da Plena Derma na CLN 309: letreiro dourado e teto de madeira" loading="lazy" />
      </figure>

      <figure class="cgal__tile cgal__tile--w reveal" style="--reveal-delay: 1">
        <img src="/clinica/fachada-frontal.jpg" alt="Letreiro frontal da Plena Derma visto da quadra" loading="lazy" />
      </figure>

      <figure class="cgal__tile cgal__tile--t reveal" style="--reveal-delay: 2">
        <img src="/clinica/logo-jardim.jpg" alt="Jardim vertical da recepção com o logo dourado da Plena Derma" loading="lazy" />
      </figure>

      <figure class="cgal__tile cgal__tile--t reveal" style="--reveal-delay: 1">
        <img src="/clinica/entrada-v.jpg" alt="Entrada da Plena Derma com cliente chegando" loading="lazy" />
      </figure>

      <figure class="cgal__tile cgal__tile--w reveal" style="--reveal-delay: 2">
        <img src="/clinica/bancada.jpg" alt="Bancada de atendimento da Plena Derma com pia dourada" loading="lazy" />
      </figure>
    </div>

    <p class="cgal__address reveal">
      {CLINIC.address.street} · {CLINIC.address.neighborhood} · {CLINIC.address.city}, {CLINIC.address.state}
      <a href={CLINIC.mapLink} target="_blank" rel="noopener noreferrer">Como chegar →</a>
    </p>
  </div>
</section>

<style>
  .cgal {
    background-color: var(--brand-cream);
    color: var(--brand-dark);
    padding-block: clamp(6rem, 12vh, 10rem);
  }

  .cgal__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    justify-content: space-between;
    margin-block-end: clamp(3rem, 6vh, 5rem);
  }
  @media (min-width: 900px) {
    .cgal__head { flex-direction: row; align-items: flex-end; }
  }

  .cgal__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--brand-accent);
    margin-block-end: var(--space-3);
  }

  .cgal__title {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    letter-spacing: var(--track-tight);
    line-height: 1;
  }
  .cgal__title em { font-style: italic; color: var(--brand-accent); }

  .cgal__head-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 30rem;
  }
  .cgal__lead {
    font-family: var(--font-sans);
    font-weight: var(--weight-light);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-body);
  }
  .cgal__link { color: var(--brand-accent); align-self: flex-start; }

  /* Galeria: fachada inteira em cima (aspect casado com o corte, nada do
     letreiro é cortado). Abaixo, duas linhas 7/5 com cenas completas:
     frontal + jardim, sala + entrada. Alturas casadas por linha. */
  .cgal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 700px) {
    .cgal__grid {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--space-5);
    }
    .cgal__tile--fachada { grid-column: 1 / -1; }
    .cgal__tile--w { grid-column: span 7; }
    .cgal__tile--t { grid-column: span 5; }
  }

  .cgal__tile {
    overflow: hidden;
    position: relative;
  }
  .cgal__tile--fachada {
    /* mesmo aspect do corte (1080x567): o letreiro aparece por completo */
    aspect-ratio: 1080 / 567;
  }
  .cgal__tile--w { aspect-ratio: 4 / 3; }
  .cgal__tile--t { aspect-ratio: 20 / 21; }

  .cgal__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.04) saturate(0.97);
    transition: transform 1400ms var(--ease-out);
  }
  .cgal__tile:hover img { transform: scale(1.035); }

  .cgal__address {
    margin-block-start: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--brand-accent);
    border-block-start: 1px solid var(--border-faint);
    padding-block-start: var(--space-5);
  }
  .cgal__address a {
    color: var(--brand-dark);
    border-block-end: 1px solid var(--border-faint);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .cgal__address a:hover { color: var(--brand-accent); }
</style>
