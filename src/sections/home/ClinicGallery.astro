---
/**
 * ClinicGallery v1.0 - bento editorial com fotos reais da clínica + stats.
 */
import { CLINIC } from '../../lib/clinic';
---

<section id="clinica" class="cgal">
  <div class="container container--wide">
    <header class="cgal__head reveal">
      <div>
        <p class="cgal__eyebrow">04 - A Clínica</p>
        <h2 class="cgal__title">A casa da<br /><em>Plena Derma.</em></h2>
      </div>
      <div class="cgal__head-right">
        <p class="cgal__lead">
          Mais de 3 anos de história na Asa Norte: a mesma equipe, o mesmo
          padrão de excelência, agora com liberdade para ir além. Um espaço
          pensado para acolher você da recepção ao pós-protocolo.
        </p>
        <a href="/sobre/" class="link-edit cgal__link">Conhecer a clínica e a equipe →</a>
      </div>
    </header>

    <div class="cgal__grid">
      <figure class="cgal__tile cgal__tile--letreiro reveal">
        <img src="/clinica/clinica-1.jpg" alt="Fachada da Plena Derma na CLN 309 - letreiro dourado" loading="lazy" />
      </figure>

      <div class="cgal__tile cgal__tile--stat reveal" style="--reveal-delay: 1">
        <span class="cgal__stat-num">3+</span>
        <span class="cgal__stat-label">Anos de história<br />na Asa Norte</span>
      </div>

      <figure class="cgal__tile cgal__tile--detalhe reveal" style="--reveal-delay: 2">
        <img src="/clinica/clinica-2.jpg" alt="Detalhe do letreiro dourado da Plena Derma" loading="lazy" />
      </figure>

      <figure class="cgal__tile cgal__tile--retrato reveal" style="--reveal-delay: 1">
        <img src="/fotos/close-perfil.jpg" alt="Perfil de pele iluminada em tons quentes" loading="lazy" />
      </figure>

      <div class="cgal__tile cgal__tile--stat cgal__tile--stat-dark reveal" style="--reveal-delay: 2">
        <span class="cgal__stat-num">4</span>
        <span class="cgal__stat-label">Salas de<br />atendimento</span>
      </div>

      <div class="cgal__tile cgal__tile--quote reveal" style="--reveal-delay: 3">
        <p class="cgal__quote">"É por isso que cada <em>etapa importa.</em>"</p>
        <p class="cgal__quote-meta">Da primeira conversa ao acompanhamento</p>
      </div>
    </div>

    <p class="cgal__address reveal">
      {CLINIC.address.street} · {CLINIC.address.neighborhood} · {CLINIC.address.city}, {CLINIC.address.state}
      <a href={CLINIC.mapLink} target="_blank" rel="noopener noreferrer">Como chegar →</a>
    </p>
  </div>
</section>

<style>
  .cgal {
    background-color: var(--brand-cream);
    color: var(--brand-dark);
    padding-block: clamp(6rem, 12vh, 10rem);
  }

  .cgal__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    justify-content: space-between;
    margin-block-end: clamp(3rem, 6vh, 5rem);
  }
  @media (min-width: 900px) {
    .cgal__head { flex-direction: row; align-items: flex-end; }
  }

  .cgal__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--brand-accent);
    margin-block-end: var(--space-3);
  }

  .cgal__title {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    letter-spacing: var(--track-tight);
    line-height: 1;
  }
  .cgal__title em { font-style: italic; color: var(--brand-accent); }

  .cgal__head-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 30rem;
  }
  .cgal__lead {
    font-family: var(--font-sans);
    font-weight: var(--weight-light);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-body);
  }
  .cgal__link { color: var(--brand-accent); align-self: flex-start; }

  /* Bento */
  .cgal__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(150px, auto);
    gap: var(--space-4);
  }
  @media (min-width: 900px) {
    .cgal__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: 280px 280px;
      gap: var(--space-5);
    }
    .cgal__tile--letreiro { grid-column: 1 / span 2; }
    .cgal__tile--retrato  { grid-row: 1 / span 2; grid-column: 4; }
    .cgal__tile--quote    { grid-column: 2 / span 2; }
  }

  .cgal__tile {
    overflow: hidden;
    position: relative;
    min-height: 150px;
  }
  .cgal__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.04) saturate(0.95);
    transition: transform 1400ms var(--ease-out);
  }
  .cgal__tile:hover img { transform: scale(1.045); }
  .cgal__tile--letreiro img { object-position: center 60%; }

  /* Stat tiles */
  .cgal__tile--stat {
    background-color: var(--brand-light);
    border: 1px solid var(--border-faint);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-6);
  }
  .cgal__tile--stat-dark {
    background-color: var(--brand-dark);
    border: none;
    color: var(--brand-light);
  }
  .cgal__stat-num {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 0.9;
    color: var(--brand-accent);
  }
  .cgal__tile--stat-dark .cgal__stat-num { color: var(--brand-gold); }
  .cgal__stat-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    line-height: 1.6;
    color: var(--text-soft);
  }
  .cgal__tile--stat-dark .cgal__stat-label { color: rgba(250, 248, 245, 0.6); }

  /* Quote tile */
  .cgal__tile--quote {
    background-color: var(--brand-light);
    border: 1px solid var(--border-faint);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-7);
  }
  .cgal__quote {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.2;
    text-wrap: balance;
  }
  .cgal__quote em { font-style: italic; color: var(--brand-accent); }
  .cgal__quote-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--text-soft);
  }

  .cgal__address {
    margin-block-start: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
    color: var(--brand-accent);
    border-block-start: 1px solid var(--border-faint);
    padding-block-start: var(--space-5);
  }
  .cgal__address a {
    color: var(--brand-dark);
    border-block-end: 1px solid var(--border-faint);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .cgal__address a:hover { color: var(--brand-accent); }
</style>
